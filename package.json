{
  "name": "translate-china",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "node scripts/check-assets.mjs && wxt build",
    "zip": "npm run build && wxt zip",
    "postinstall": "wxt prepare",
    "assets": "node scripts/prepare-assets.mjs",
    "typecheck": "tsc --noEmit",
